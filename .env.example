# =============================================================================
# CityGuide — environment variables
# =============================================================================
# Copy this file to `.env` (repository root) or `backend/.env` and fill in the
# values you need. Nothing here contains a real secret, and `.env` is gitignored.
#
#   cp .env.example .env
#
# Every variable has a sensible default, so a fresh clone runs with no .env at
# all (using a local SQLite file database).
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | production | test
NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Set to true when running behind exactly one reverse proxy (Render, Railway,
# Fly, nginx). This makes req.ip reflect the real client for rate limiting and
# audit logs. Leave false when running locally.
TRUST_PROXY=false


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Leave DATABASE_DRIVER unset to auto-detect: if DATABASE_URL is present the
# PostgreSQL driver is used, otherwise the built-in SQLite driver is.
# Explicit values: sqlite | postgres
# DATABASE_DRIVER=sqlite

# PostgreSQL / Supabase connection string. Setting this switches the whole
# application to PostgreSQL, including running the PostgreSQL migrations.
#
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the connection pooler (port 6543) for serverless hosts, or the direct
# connection (port 5432) for a long-running server such as Render.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Path to the SQLite file used when the SQLite driver is active.
# SQLITE_PATH=./database/cityguide.db

# Require TLS for the PostgreSQL connection. Auto-enabled when DATABASE_URL
# points at supabase.co / supabase.com, or when NODE_ENV=production.
# DATABASE_SSL=true

# Maximum PostgreSQL pool size.
# DATABASE_POOL_MAX=10


# -----------------------------------------------------------------------------
# Sessions and cookies
# -----------------------------------------------------------------------------
# Name of the httpOnly session cookie.
SESSION_COOKIE_NAME=cityguide_session

# Session lifetime in hours (default 7 days).
SESSION_TTL_HOURS=168

# Send the cookie only over HTTPS. Must be true in production.
# In development this stays false so http://localhost works.
SESSION_COOKIE_SECURE=false

# lax | strict | none
#
# Use `lax` when the frontend and API share a site (including localhost through
# the Vite proxy) — it is the safer setting.
#
# Use `none` when the frontend and API are on DIFFERENT sites, for example a
# Vercel frontend calling a Render API. `none` REQUIRES SESSION_COOKIE_SECURE=true
# and HTTPS, or browsers will silently drop the cookie and sign-in will appear
# to succeed but never persist.
SESSION_COOKIE_SAMESITE=lax


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API with credentials.
# Include the exact scheme and host of the deployed frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173


# -----------------------------------------------------------------------------
# Nominatim / OpenStreetMap geocoding
# -----------------------------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# REQUIRED BEFORE PUBLIC DEPLOYMENT.
#
# Nominatim's usage policy requires a User-Agent that identifies your
# application and gives a contact address. The OSM Foundation rejects
# User-Agents containing placeholder domains such as `example.com`, so the
# built-in default deliberately carries no contact rather than a fictitious one.
#
# Set something like:
#   NOMINATIM_USER_AGENT=CityGuide/1.0 (+https://your-app.example) you@your-domain.example
#
# NOMINATIM_USER_AGENT=

# Optional contact address, passed to Nominatim as the `email` parameter. This
# is the alternative to putting a contact in the User-Agent.
# NOMINATIM_EMAIL=

# Minimum gap between outbound geocoding requests, in milliseconds. Nominatim
# asks for at most one request per second — do not lower this.
GEOCODE_MIN_INTERVAL_MS=1100

# Abort an outbound geocoding request after this long.
GEOCODE_TIMEOUT_MS=8000

# How long a cached geocoding result stays valid.
GEOCODE_CACHE_TTL_DAYS=30


# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Sign-in and registration attempts.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# All other API requests, per window, per IP.
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1000

# Location lookups. Deliberately tight: they reach a shared public service.
RATE_LIMIT_GEOCODE_WINDOW_MS=60000
RATE_LIMIT_GEOCODE_MAX=20


# -----------------------------------------------------------------------------
# Pagination
# -----------------------------------------------------------------------------
PAGINATION_DEFAULT_LIMIT=12
PAGINATION_MAX_LIMIT=100


# -----------------------------------------------------------------------------
# Seeding
# -----------------------------------------------------------------------------
# The seeder refuses to create the well-known demo accounts when
# NODE_ENV=production. Set this to true only if you deliberately want public
# demo credentials on a production deployment (you almost certainly do not).
# ALLOW_PRODUCTION_SEED=false


# -----------------------------------------------------------------------------
# Frontend (Vite) — these are compiled into the browser bundle
# -----------------------------------------------------------------------------
# Full base URL of the API, including /api.
#
# Leave EMPTY for local development: the frontend calls a relative `/api` path
# and Vite's dev server proxies it to the backend, which avoids CORS entirely.
#
# Set it for a deployed frontend, for example:
#   VITE_API_URL=https://cityguide-api.onrender.com/api
#
# VITE_API_URL=

# Where the Vite dev/preview proxy forwards `/api` requests.
# VITE_PROXY_TARGET=http://localhost:4000
