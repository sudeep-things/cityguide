    "seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js",
    "test": "node tests/e2e.mjs",
    "test:unit": "node --test tests/unit/"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.13"
