{
  "name": "cityguide-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CityGuide REST API - attractions, itineraries, saved places, geocoding",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
